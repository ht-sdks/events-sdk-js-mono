{
  "$schema": "https://turborepo.dev/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "**/tsconfig*.json",
        "**/babel.config*",
        "**/webpack.config*",
        "**/*.ts",
        "**/*.tsx",
        "!**/__tests__/**",
        "!src/**/test-helpers/**"
      ],
      "outputs": ["**/dist/**", ".next/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:int": {
      "dependsOn": ["build"]
    },
    "watch": {
      "cache": false,
      "persistent": true,
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["build"],
      "inputs": ["**/tsconfig*.json", "**/*.ts", "**/*.tsx", "**/*.js"],
      "outputs": []
    },
    "test:cloudflare-workers": {
      "dependsOn": ["build"]
    },
    "test:perf-and-durability": {
      "dependsOn": ["build"]
    }
  }
}
